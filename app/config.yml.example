# ===========================================
# CRYPTO-SIGNAL: Configuración Profesional
# ===========================================
# Copia este archivo como config.yml en la raíz del proyecto
# Documentación: docs/config.md

settings:
  update_interval: 300          # Segundos entre análisis (5 min)
  market_pairs: false           # false = usar dynamic_pairs
  enable_charts: true           # Genera gráficos técnicos PNG
  timezone: America/Santiago    # Tu zona horaria
  
  # MODO DINÁMICO (Top N pares por volumen)
  dynamic_pairs:
    enabled: true
    top_n: 50
    min_volume_24h: 1000000     # Mínimo $1M volumen 24h
    exclude:
      - USDC/USDT
      - BUSD/USDT
      - TUSD/USDT
  
  # ANÁLISIS DE CORRELACIÓN (Fase 4)
  correlation:
    enabled: true
    reference_pair: BTC/USDT
    thresholds:
      btc_bullish: 2.0          # BTC > +2% = alcista
      btc_bearish: -2.0         # BTC < -2% = bajista
      outperform_ratio: 1.2     # ALT > 1.2x BTC = supera
    quality_filter:
      enabled: false            # true = solo enviar A+ y A

exchanges:
  binance:
    required:
      enabled: true

notifiers:
  telegram:
    required:
      token: "TU_TOKEN_AQUI"      # Obtener de @BotFather
      chat_id: "TU_CHAT_ID_AQUI"  # Obtener de @userinfobot
    optional:
      parse_mode: html
      template: |
        {% if status == 'hot' %}🟢 <b>Aviso informativo RSI/MACD: posible rebote</b>{% else %}🔴 <b>Aviso informativo RSI/MACD: posible corrección</b>{% endif %}

        📊 <b>{{market}}</b> ({{analysis.config.candle_period}})
        {{hot_cold_label|default('Señal detectada')}}

        {% if btc_trend == 'bullish' %}BTC hoy: 🟢 sube {{ (btc_change_24h|default(0))|abs|round(1) }}% en 24 h{% elif btc_trend == 'bearish' %}BTC hoy: 🔴 baja {{ (btc_change_24h|default(0))|abs|round(1) }}% en 24 h{% else %}BTC hoy: ⚪ lateral{% endif %}

        ⚠️ <b>Ojo:</b> en nuestras pruebas, los avisos de RSI/MACD <b>no predijeron el precio</b>. No compres ni vendas solo por esto. La señal principal del bot es «OPORTUNIDAD DE COMPRA».

        🕐 {{creation_date}}
# =====================
# INDICADORES
# =====================
indicators:
  macd_cross:
    - enabled: true
      alert_enabled: true
      alert_frequency: once
      signal: [macd, signal]
      hot_label: "🟢 MACD cruzó al alza (impulso alcista)"
      cold_label: "🔴 MACD cruzó a la baja (impulso bajista)"
      indicator_label: "MACD Cross 4h"
      mute_cold: false
      candle_period: 4h

  rsi:
    - enabled: true
      alert_enabled: true
      alert_frequency: once
      signal: [rsi]
      hot: 35
      cold: 65
      hot_label: "🟢 RSI en sobreventa"
      cold_label: "🔴 RSI en sobrecompra"
      mute_cold: false
      candle_period: 4h
      period_count: 14

  # Deshabilitados
  momentum:
    - enabled: false
  mfi:
    - enabled: false
  obv:
    - enabled: false
  stoch_rsi:
    - enabled: false
  ichimoku:
    - enabled: false

# =====================
# INFORMANTES
# =====================
informants:
  ema:
    - enabled: true
      signal: [ema]
      candle_period: 4h
      period_count: 99

  sma:
    - enabled: true
      signal: [sma]
      candle_period: 4h
      period_count: 200

  bollinger_bands:
    - enabled: true
      signal: [upperband, middleband, lowerband]
      candle_period: 4h
      period_count: 21

  ohlcv:
    - enabled: true
      signal: [open, high, low, close]
      candle_period: 4h
      period_count: 15

  lrsi:
    - enabled: true
      signal: [lrsi]
      candle_period: 4h

  vwap:
    - enabled: true
      signal: [vwap]
      candle_period: 4h

crossovers:
  std_crossover:
    - enabled: false
