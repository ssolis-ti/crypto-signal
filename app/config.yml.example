# ===========================================
# CRYPTO-SIGNAL: Configuración Profesional
# ===========================================
# Copia este archivo como config.yml en la raíz del proyecto
# Documentación: docs/config.md

settings:
  update_interval: 300          # Segundos entre análisis (5 min)
  market_pairs: false           # false = usar dynamic_pairs
  enable_charts: true           # Genera gráficos técnicos PNG
  timezone: America/Santiago    # Tu zona horaria
  
  # MODO DINÁMICO (Top N pares por volumen)
  dynamic_pairs:
    enabled: true
    top_n: 50
    min_volume_24h: 1000000     # Mínimo $1M volumen 24h
    exclude:
      - USDC/USDT
      - BUSD/USDT
      - TUSD/USDT
  
  # ANÁLISIS DE CORRELACIÓN (Fase 4)
  correlation:
    enabled: true
    reference_pair: BTC/USDT
    thresholds:
      btc_bullish: 2.0          # BTC > +2% = alcista
      btc_bearish: -2.0         # BTC < -2% = bajista
      outperform_ratio: 1.2     # ALT > 1.2x BTC = supera
    quality_filter:
      enabled: false            # true = solo enviar A+ y A

exchanges:
  binance:
    required:
      enabled: true

notifiers:
  telegram:
    required:
      token: "TU_TOKEN_AQUI"      # Obtener de @BotFather
      chat_id: "TU_CHAT_ID_AQUI"  # Obtener de @userinfobot
    optional:
      parse_mode: html
      template: |
        {% if status == 'hot' %}🟢 <b>COMPRA</b>{% else %}🔴 <b>VENTA</b>{% endif %} {% if quality == 'A+' %}⭐⭐⭐{% elif quality == 'A' %}⭐⭐{% elif quality == 'B' %}⭐{% endif %}
        
        📊 <b>{{market}}</b> | {{analysis.config.candle_period}}
        🎯 {{hot_cold_label|default('Señal detectada')}}
        
        {% if btc_trend == 'bullish' %}🟢 BTC Alcista (+{{btc_change_24h|default(0)|round(1)}}%){% elif btc_trend == 'bearish' %}🔴 BTC Bajista ({{btc_change_24h|default(0)|round(1)}}%){% else %}⚪ BTC Neutral{% endif %}
        
        {% if quality == 'A+' %}⚡ A+ Señal muy fuerte ({{score|default(50)|round(0)|int}}){% elif quality == 'A' %}✅ A Señal sólida ({{score|default(50)|round(0)|int}}){% elif quality == 'B' %}⚠️ B Confirmar ({{score|default(50)|round(0)|int}}){% else %}❌ C Precaución ({{score|default(50)|round(0)|int}}){% endif %}
        
        {% if context_note %}💡 {{context_note}}{% endif %}
        
        ━━━━━━━━━━━━━━━━━━━━
        <code>
        [TECHNICAL_DATA]
        timestamp={{creation_date}}
        pair={{market}}
        exchange={{exchange}}
        timeframe={{analysis.config.candle_period}}
        signal_type={% if status == 'hot' %}BUY{% else %}SELL{% endif %}
        quality_grade={{quality|default('B')}}
        score={{score|default(50)}}
        btc_trend={{btc_trend|default('neutral')}}
        btc_24h_pct={{btc_change_24h|default(0)}}
        context_note={{context_note|default('')}}
        ohlcv={{prices}}
        [/TECHNICAL_DATA]
        </code>

# =====================
# INDICADORES
# =====================
indicators:
  macd_cross:
    - enabled: true
      alert_enabled: true
      alert_frequency: once
      signal: [macd, signal]
      hot_label: "🟢 MACD cruce ALCISTA"
      cold_label: "🔴 MACD cruce BAJISTA"
      indicator_label: "MACD Cross 4h"
      mute_cold: false
      candle_period: 4h

  rsi:
    - enabled: true
      alert_enabled: true
      alert_frequency: once
      signal: [rsi]
      hot: 35
      cold: 65
      hot_label: "🟢 RSI en sobreventa"
      cold_label: "🔴 RSI en sobrecompra"
      mute_cold: false
      candle_period: 4h
      period_count: 14

  # Deshabilitados
  momentum:
    - enabled: false
  mfi:
    - enabled: false
  obv:
    - enabled: false
  stoch_rsi:
    - enabled: false
  ichimoku:
    - enabled: false

# =====================
# INFORMANTES
# =====================
informants:
  ema:
    - enabled: true
      signal: [ema]
      candle_period: 4h
      period_count: 99

  sma:
    - enabled: true
      signal: [sma]
      candle_period: 4h
      period_count: 200

  bollinger_bands:
    - enabled: true
      signal: [upperband, middleband, lowerband]
      candle_period: 4h
      period_count: 21

  ohlcv:
    - enabled: true
      signal: [open, high, low, close]
      candle_period: 4h
      period_count: 15

  lrsi:
    - enabled: true
      signal: [lrsi]
      candle_period: 4h

  vwap:
    - enabled: true
      signal: [vwap]
      candle_period: 4h

crossovers:
  std_crossover:
    - enabled: false
