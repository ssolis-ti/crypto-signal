# ===========================================
# CRYPTO-SIGNAL: Configuración Optimizada
# ===========================================
# Copia este archivo como config.yml
# Ubicación: app/config.yml

settings:
  update_interval: 300        # Segundos entre análisis (5 min)
  market_pairs:
    - BTC/USDT
    - ETH/USDT
  enable_charts: true         # Genera gráficos técnicos
  timezone: America/Santiago  # Tu zona horaria

exchanges:
  binance:
    required:
      enabled: true
    # all_pairs: [USDT]       # Descomenta para escanear TODO
    # exclude: [USDC, BUSD]   # Ignorar stablecoins

notifiers:
  telegram:
    required:
      token: "TU_TOKEN_AQUI"      # Obtener de @BotFather
      chat_id: "TU_CHAT_ID_AQUI"  # Obtener de @userinfobot
    optional:
      parse_mode: html
      template: |
        {% if status == 'hot' %}🟢 <b>SEÑAL DE COMPRA</b>{% else %}🔴 <b>SEÑAL DE VENTA</b>{% endif %}
        
        📊 <b>{{market}}</b> @ {{exchange}}
        ⏱️ Timeframe: {{analysis.config.candle_period}}
        📉 {{indicator|upper}}: {{values}}
        💵 Precio actual: ${{price_value.close}}
        🕐 {{creation_date}}

# =====================
# INDICADORES ACTIVOS
# =====================
indicators:
  # RSI - Índice de Fuerza Relativa
  rsi:
    - enabled: true
      alert_enabled: true
      alert_frequency: once
      signal: [rsi]
      hot: 30                 # RSI < 30 = Sobreventa (compra)
      cold: 70                # RSI > 70 = Sobrecompra (venta)
      hot_label: "🟢 RSI en sobreventa"
      cold_label: "🔴 RSI en sobrecompra"
      mute_cold: false
      candle_period: 4h
      period_count: 14

  # MACD - Moving Average Convergence Divergence
  macd:
    - enabled: true
      alert_enabled: true
      alert_frequency: once
      signal: [macd, macdsignal]
      hot: 0                  # MACD cruza hacia arriba
      cold: 0                 # MACD cruza hacia abajo
      hot_label: "🟢 MACD cruce alcista"
      cold_label: "🔴 MACD cruce bajista"
      mute_cold: false
      candle_period: 4h

  # =====================
  # INDICADORES DESHABILITADOS
  # =====================
  momentum:
    - enabled: false
  mfi:
    - enabled: false
  obv:
    - enabled: false
  stoch_rsi:
    - enabled: false
  ichimoku:
    - enabled: false
  iiv:
    - enabled: false

# =====================
# INFORMANTES (datos adicionales)
# =====================
informants:
  ohlcv:
    - enabled: true
      signal: [open, high, low, close]
      candle_period: 4h
  lrsi:
    - enabled: true
      signal: [lrsi]
      candle_period: 4h
      period_count: 14
  bollinger_bands:
    - enabled: true
      candle_period: 4h
      period_count: 21
