# Copiar a .env (ignorado por git) y completar. docker compose lo carga en el contenedor.
# Tienen prioridad sobre notifiers.telegram.required de config.yml.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# specs/031-wyckoff-twitter-sentiment/: opcional, solo si settings.wyckoff_alerts.twitter_sentiment.enabled=true.
# GetXAPI (docs.getxapi.com) -- Bearer key, $0.001/consulta, se usa solo por evento Wyckoff ya calificado (raro).
GETXAPI_API_KEY=
# Google Gemini (generativelanguage.googleapis.com) -- API key para clasificar el contenido de los tweets.
GEMINI_API_KEY=
